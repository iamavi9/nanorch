# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  javascript/Sqli:
    - '*':
        reason: >-
          False positive / accepted risk — LLM generates SQL from user intent;
          the SQL is not directly controlled by the user (req.body.content flows
          through the Anthropic/OpenAI API before becoming a tool argument).
          The AI SQL assistant is a by-design feature.
        expires: 2030-01-01T00:00:00.000Z
        created: 2026-04-16T10:41:06.664Z
  javascript/Ssrf:
    - '*':
        reason: >-
          False positive / accepted risk — git webhook body (branch, changedFiles)
          flows into the LLM agent prompt; the LLM is an opaque transformation
          boundary the scanner cannot model. fetchNanoOrchYml uses a hardcoded
          "HEAD" literal; cloneRepo uses spawn (not fetch). Signature verification
          (HMAC-SHA256) ensures only legitimate GitHub/GitLab webhooks are processed.
        expires: 2030-01-01T00:00:00.000Z
        created: 2026-04-16T10:41:21.027Z
  javascript/OR:
    - '*':
        reason: >-
          False positive / accepted risk — OIDC redirect URL is reconstructed from
          parsed components (origin + pathname + search) after hostname validation
          against cfg.discoveryUrl; SAML redirect similarly validated against
          cfg.entryPoint. safeRedirectPath() enforces path-only redirects for the
          post-login destination.
        expires: 2030-01-01T00:00:00.000Z
        created: 2026-04-16T10:41:23.008Z
  javascript/HttpToHttps:
    - '*':
        reason: >-
          False positive — the application runs behind a TLS-terminating reverse
          proxy in production; an explicit HTTPS redirect middleware is registered
          at server startup (server/index.ts). createServer is intentionally called
          with the plain http module because TLS is terminated upstream.
        expires: 2030-01-01T00:00:00.000Z
        created: 2026-04-16T10:41:24.962Z
patch: {}
exclude:
  code:
    - server/routes.ts
    - server/index.ts
    - server/engine/git-feedback.ts
    - server/comms/teams-handler.ts
    - package.json
